# Solo NOMBRES, nunca valores. Copia este archivo a `.env.local` (no se versiona) y completa los valores allí,
# y carga los mismos nombres en Vercel (Settings > Environment Variables).
# Ninguna variable lleva el prefijo VITE_: así nunca llegan al navegador.

# --- ACTA (testnet) ---
ACTA_API_BASE=
ACTA_API_KEY=
DID_RESOLVER_BASE=

# --- Red de Stellar (opcional: si queda vacía se usa el RPC público de testnet) ---
STELLAR_RPC_URL=

# --- Institución de prueba (datos públicos) ---
INSTITUTION_PUBLIC_KEY=
INSTITUTION_DID=
INSTITUTION_NAME=
# Opcional (dato público): dirección del contrato del vault de la institución (C...). Evita una lectura a ACTA
# en cada emisión o revocación. Si se deja vacío, se lee de ACTA.
INSTITUTION_VAULT_ADDRESS=

# --- Sesión del panel ---
SESSION_SECRET=

# --- Firma del emisor (on / off) ---
# on: cada credencial lleva la firma de la institución (Freighter) y la verificación la exige.
# off (por defecto): solo rige la regla del emisor y del vault.
SIGNATURE_LAYER=
